      "content": [
        {
          "id": "chapter02-block-70",
          "type": "list",
          "data": {
            "ordered": false,
            "items": [
              {
                "text": "Docker Client ≠ Docker Daemon"
              },
              {
                "text": "docker run = 다단계 작업"
              },
              {
                "text": "containerd / runc 존재 이유"
              },
              {
