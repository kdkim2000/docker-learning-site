      "content": [
        {
          "id": "chapter03-block-75",
          "type": "code",
          "data": {
            "language": "bash",
            "code": "# gpg key download (방법 1)\ncurl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg\n\n# gpg key download (방법 2)\nsudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo apt-key add -\n# OK\n\n# Docker repository 등록\necho \"deb [arch=amd64 signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable\" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null\n\n# 패키지 정보 갱신\nsudo apt update",
            "copyable": true
          }
        }
      ]
    },
